# Configure this independent service explicitly. Never copy a populated v1 env file.
MONGODB_URI=mongodb://127.0.0.1:27017/hrms_v2_isolated
JWT_SECRET=replace-with-securely-provisioned-compatible-signing-key
JWT_EXPIRES_IN=1d
# Used only by the explicit `npm run bootstrap:system` command. Set these
# securely when creating the initial SYSTEM superadmin; never use defaults.
# HRMS_BOOTSTRAP_EMAIL=
# HRMS_BOOTSTRAP_PASSWORD=
PORT=8002
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
MONGODB_POOL_MAX=5
DEPENDENCY_TIMEOUT_MS=10000
TOKEN_LIST_LIMIT=10
MAX_ACTIVE_LOGINS_PER_USER_DEFAULT=1
BCRYPT_SALT_ROUNDS=10
# Set only behind known proxies, using explicit IP/CIDR values.
# TRUST_PROXY=127.0.0.1
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# FRONTEND_LOGIN_URL=
# HR_CONTACT_EMAIL=
# FACEPP_API_KEY=
# FACEPP_API_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FCM_ANDROID_CHANNEL_ID=rigweda-notifications
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=rigweda-monitor-updates
# MONITOR_UPDATE_URL_EXPIRES_SECONDS=900
# MONITOR_RELEASE_SIGNED_URL=
# Monitor PostgreSQL is shared with monitor/HRMS v1; do not point tests at populated hosts.
# MONITOR_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/monitor_test
# MONITOR_PG_POOL_MAX=20
# MONITOR_PG_SSL_MODE=require
# Payroll PostgreSQL remains opt-in, matching the existing HRMS deployment behavior.
# PAYROLL_DB_ENABLED=true
# PAYROLL_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/payroll_test
# PAYROLL_PG_POOL_MAX=20
# PAYROLL_PG_SSL_MODE=require
# PAYROLL_IDEMPOTENCY_REQUIRED=false
# PAYROLL_COMPUTE_ASYNC_DEFAULT=false
# PAYROLL_DEFAULT_TIMEZONE=Asia/Kolkata
# PAYROLL_COUNTRY=IN
# PAYROLL_STATE_CODE=TS
# PAYROLL_DEFAULT_SALARY_PAY_DAY=30
# PAYROLL_OT_MULTIPLIER=1
# PAYROLL_PF_WAGE_THRESHOLD=15000
# PAYROLL_ESI_WAGE_THRESHOLD=21000
# IFSC_LOOKUP_BASE_URL=https://ifsc.razorpay.com
# IFSC_LOOKUP_TIMEOUT_MS=10000
# These settings are inert without caller-provided queue and worker factories.
# ENABLE_JOB_SCHEDULER=false
# ENABLE_JOB_WORKER=false
# JOB_QUEUE_NAME=rigweda-system-jobs
# JOB_WORKER_CONCURRENCY=1
# JOB_CRON_LEAVE_CREDIT=0 0 * * *
# JOB_CRON_LEAVE_CARRY_FORWARD=0 0 * * *
# JOB_CRON_PROBATION_COMPLETION=0 0 * * *
# JOB_CRON_ORGANIZATION_DOCUMENT_EXPIRY=30 8 * * *
# JOB_CRON_ATTENDANCE_AUTO_CHECKOUT=59 23 * * *
# JOB_TIMEZONE=Asia/Kolkata
FACE_MATCH_MIN_CONFIDENCE=70
FACE_LOGIN_ALLOW_PASSWORD_FALLBACK=false

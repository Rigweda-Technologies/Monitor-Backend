{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "src/**/*.cjs", "scripts/**/*.js", "scripts/**/*.cjs"],
  "exclude": ["node_modules", "generated", "tests", "ci"]
}

{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["app.js", "swagger.js", "src/**/*.js", "src/**/*.cjs"],
  "exclude": ["node_modules", "tests", "ci"]
}
